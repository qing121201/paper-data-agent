# OpenAI official API example
PAPER_AGENT_BASE_URL=https://api.openai.com/v1
PAPER_AGENT_API_KEY=replace-with-your-key
PAPER_AGENT_MODEL=replace-with-a-model-you-can-access
PAPER_AGENT_API_STYLE=responses

# For an OpenAI-compatible local/server endpoint, change BASE_URL and usually use:
# PAPER_AGENT_API_STYLE=chat_completions
# Some local endpoints accept any non-empty key; follow that provider's settings.
PAPER_AGENT_TIMEOUT=90
# Leave empty for the provider default (DeepSeek thinking mode defaults to 64K).
PAPER_AGENT_MAX_OUTPUT_TOKENS=
